[Unit]
Description=GitgitDev developer site (gitgitdev.my.id)
After=network-online.target

[Service]
WorkingDirectory=/home/gitgitmiko/github-repos/gitgitdev-site
ExecStartPre=/usr/bin/python3 build.py
ExecStart=/usr/bin/python3 serve.py --port 8796
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
